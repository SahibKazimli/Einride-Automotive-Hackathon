      <parent>base_link</parent>
      <child>right_down_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>10</effort><velocity>30</velocity></limit>
        <dynamics><damping>0.001</damping><friction>0.002</friction></dynamics>
      </axis>
    </joint>

    <!-- Luxonis OAK-D Lite.
         Body 91 x 28 x 17.5 mm, 61 g. The inherited mesh measures 91 x 28 x 17.0 mm,
         so it is reused as-is; Luxonis' own mesh is in ros-jazzy-depthai-descriptions
         if an exact model is ever wanted.

         Modelled as TWO sensors rather than one rgbd_camera, because the real
         device's colour and depth paths differ in both FOV and resolution and
         gz-sim's rgbd_camera forces a single value for both:
           colour  IMX214,        HFOV 69 deg
           depth   OV7251 stereo, HFOV 73 deg, 75 mm baseline
         The OAK-D Lite carries its own BMI270 6-axis IMU, modelled below. That
         makes two IMUs on this robot: the chassis one on base_imu_link and the
         camera's, which are separate hardware and separate topics. -->
    <link name='oak_d_lite_link'>
      <pose relative_to='base_footprint'>0.06577 0 0.101953 0 0 0</pose>
      <inertial>
        <!-- 61 g solid box, 17.5 x 91 x 28 mm -->
        <mass>0.061</mass>
        <inertia>
          <ixx>4.6080E-05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>5.5429E-06</iyy><iyz>0</iyz>
          <izz>4.3654E-05</izz>
        </inertia>
      </inertial>
      <visual name='oak_d_lite_link_visual'>
        <geometry>
          <mesh><scale>1 1 1</scale><uri>package://einride_mini_truck_description/models/einride_mini_truck/meshes/oak_d_lite_link.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.06 1</ambient>
          <diffuse>0.13 0.13 0.15 1</diffuse>
          <specular>0.45 0.45 0.50 1</specular>
        </material>
      </visual>
      <collision name='oak_d_lite_link_collision'>
        <geometry>
          <mesh><scale>1 1 1</scale><uri>package://einride_mini_truck_description/models/einride_mini_truck/meshes/oak_d_lite_link.stl</uri></mesh>
        </geometry>
      </collision>

      <!-- Colour: IMX214, 1052x780 = exactly 4208/4 x 3120/4.
           Scaling by a whole fraction preserves the sensor's native 1.3487 aspect,
           which is what makes the datasheet FOV triple come out exactly right:
           69.0 HFOV -> 54.0 VFOV, 81.1 DFOV (datasheet 69 / 54 / 81). Note the
           native frame is NOT 4:3 - forcing 4:3 would give VFOV 54.5 instead.
           On real hardware this is depthai's i_isp_num=1 / i_isp_den=4.

           Both streams are declared at 30 Hz, which is the device's own rate at
           these modes. What Gazebo actually delivers depends entirely on the
           render path: run the server with DISPLAY pointed at a GPU-backed X
           display to get hardware acceleration (the process then shows up in
           nvidia-smi). Headless or on Xvfb it falls back to llvmpipe software
           rendering and the achieved rate drops well below 30. -->
      <sensor name='oak_rgb' type='camera'>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>oak/rgb/image_raw</topic>
        <gz_frame_id>oak_d_lite_link</gz_frame_id>
        <camera name='imx214'>
          <horizontal_fov>1.20428</horizontal_fov>
          <image><width>1052</width><height>780</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>50</far></clip>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
          <optical_frame_id>oak_d_lite_link</optical_frame_id>
        </camera>
      </sensor>

      <!-- Depth from the OV7251 stereo pair: 640x480, 73 deg HFOV, 0.2-19 m.
           Depth is published aligned to the colour centre, matching depthai's
           default align_depth behaviour, rather than at the right mono camera. -->
      <sensor name='oak_stereo' type='depth_camera'>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>oak/stereo/image_raw</topic>
        <gz_frame_id>oak_d_lite_link</gz_frame_id>
        <camera name='ov7251_stereo'>
          <horizontal_fov>1.27409</horizontal_fov>
          <image><width>640</width><height>480</height><format>R_FLOAT32</format></image>
          <clip><near>0.2</near><far>19.0</far></clip>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.003</stddev></noise>
          <optical_frame_id>oak_d_lite_link</optical_frame_id>
        </camera>
      </sensor>

      <!-- BMI270: the OAK-D Lite's integrated 6-axis IMU (accel + gyro), published
           by depthai_ros_driver on /oak/imu/data. This is separate hardware from
           the chassis IMU on base_imu_link - the robot genuinely has two.

           Noise figures are DERIVED, not datasheet sigmas: BMI270 quotes noise
           densities of ~0.007 deg/s/sqrt(Hz) for the gyro and ~160 ug/sqrt(Hz) for
           the accelerometer, which at 100 Hz bandwidth give roughly 1.2e-3 rad/s
           and 1.6e-2 m/s^2. Being a consumer part it is noisier than the figures
           carried over for the chassis IMU. Rate is set to 100 Hz; the device and
           driver support considerably more. -->
      <sensor name='oak_bmi270' type='imu'>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <topic>oak/imu/data</topic>
        <gz_frame_id>oak_d_lite_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x><noise type='gaussian'><mean>0.0</mean><stddev>1.2e-3</stddev></noise></x>
            <y><noise type='gaussian'><mean>0.0</mean><stddev>1.2e-3</stddev></noise></y>
            <z><noise type='gaussian'><mean>0.0</mean><stddev>1.2e-3</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type='gaussian'><mean>0.0</mean><stddev>1.6e-2</stddev></noise></x>
            <y><noise type='gaussian'><mean>0.0</mean><stddev>1.6e-2</stddev></noise></y>
            <z><noise type='gaussian'><mean>0.0</mean><stddev>1.6e-2</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>
    <joint name='oak_d_lite_link_joint' type='fixed'>
      <parent>base_link</parent>
      <child>oak_d_lite_link</child>
    </joint>

    <link name='base_lidar_link'>
      <pose relative_to='base_footprint'>0.040275 0 0.12 0 0 1.5707963</pose>
      <inertial>
        <mass>0.0418000091653573</mass>
        <inertia>
          <ixx>8.26853377699878E-06</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>8.26853377699876E-06</iyy><iyz>0</iyz>
          <izz>8.32524607487378E-06</izz>
        </inertia>
      </inertial>
      <visual name='base_lidar_link_visual'>
        <geometry>
          <mesh><scale>1 1 1</scale><uri>package://einride_mini_truck_description/models/einride_mini_truck/meshes/base_lidar_link.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.16 0.17 0.18 1</ambient>
          <diffuse>0.52 0.54 0.57 1</diffuse>
          <specular>0.45 0.45 0.48 1</specular>
        </material>
      </visual>
      <collision name='base_lidar_link_collision'>
        <geometry>
          <mesh><scale>1 1 1</scale><uri>package://einride_mini_truck_description/models/einride_mini_truck/meshes/base_lidar_link.stl</uri></mesh>
        </geometry>
      </collision>
      <!-- InnoMaker LD19P (LDROBOT LD19 family), DTOF 2D scanner.
           Body ~38.6 x 38.6 x 34.8 mm; the inherited 36 x 36 x 35 mm mount mesh is
           reused as close enough.

           450 samples/revolution = 4500 points/s at 10 Hz, giving 0.8 deg angular
           resolution. Scan rate is nominally 10 Hz on this device (configurable
           roughly 5-13 Hz); change update_rate and samples together to keep the
           4500 pts/s relationship if you retune it.

           Scan plane is 25 mm above the link origin, i.e. inside the upper half of
           the body. The inherited value was 40 mm, which floated the scan plane
           5 mm above the top of the physical housing. -->
      <sensor name='ld19p' type='gpu_lidar'>
        <always_on>1</always_on>
        <visualize>1</visualize>
        <update_rate>10</update_rate>
        <topic>scan</topic>
        <gz_frame_id>base_lidar_link</gz_frame_id>
        <pose>0 0 0.025 0 0 0</pose>
        <lidar>
          <scan>
            <horizontal>
              <samples>450</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.02</min>
            <max>12.0</max>
            <resolution>0.001</resolution>
          </range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.015</stddev></noise>
        </lidar>
      </sensor>
    </link>
    <joint name='base_lidar_link_joint' type='fixed'>
      <parent>base_link</parent>
      <child>base_lidar_link</child>
    </joint>


    <!-- ================= systems ================= -->

    <!-- Six wheels, four driven, per the Waveshare UGV02 chassis spec. In the
         original, the two middle wheels were part of base_link's collision mesh:
         immovable blocks at wheel height in the centre of the wheelbase, fighting
         every turn. They are now free-rolling idlers on revolute joints. -->
    <plugin filename='gz-sim-diff-drive-system' name='gz::sim::systems::DiffDrive'>
      <!-- 6 wheels, 4WD: the Waveshare UGV02 is a six-wheel, four-wheel-drive
           chassis, so only the front and rear pairs are driven. The two middle
           wheels stay revolute and free-rolling - they carry load and roll, but
           take no drive torque and are not used for odometry.

           Which four are driven is inferred, not read off the datasheet: the
           source ugv_description articulated exactly left/right_up and
           left/right_down as joints and left the middle pair as dead geometry,
           which points to the motors being on the front and rear axles. -->
      <left_joint>left_up_wheel_link_joint</left_joint>
      <left_joint>left_down_wheel_link_joint</left_joint>
      <right_joint>right_up_wheel_link_joint</right_joint>
      <right_joint>right_down_wheel_link_joint</right_joint>
      <!-- EFFECTIVE track, not the geometric one (which is 0.17452 = 2 x 0.08726).
           A skid-steer must scrub sideways to rotate, so the ideal two-wheel
           differential model over-predicts yaw rate. Measured against the IMU:
             6WD: 1.2437 / 1.2436 / 1.2432 at 0.5 / 1.0 / 1.5 rad/s -> 1.2435
             4WD: 1.2423 / 1.2437 / 1.2437 at the same rates       -> 1.2432
           Dropping to 4WD leaves it unchanged within noise, which is expected:
           during in-place rotation the middle wheels sit at the centre of the
           wheelbase, so their contact points travel purely sideways and they
           pure-scrub whether they are driven or not. Value kept at
           0.17452 * 1.2435 = 0.21701. Re-calibrate if wheel or ground friction
           changes. -->
      <wheel_separation>0.21701</wheel_separation>
      <!-- Measured from the wheel mesh (circumradius 0.040). The original declared
           wheel_diameter 0.05 on 0.08 m wheels: commands ran 1.6x fast and odometry
           read 0.625x short. -->
      <wheel_radius>0.04</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>pose</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
    </plugin>

    <plugin filename='gz-sim-joint-state-publisher-system'
            name='gz::sim::systems::JointStatePublisher'>
      <topic>joint_states</topic>
      <!-- NOTE: gz-sim 8's JointStatePublisher accepts only <joint_name> and
           <topic>; it has no rate parameter and publishes every physics step
           (~1 kHz here). The Classic plugin this replaces had update_rate 2.
           Measured downstream impact is small (/tf stays at 60 Hz,
           robot_state_publisher ~5% CPU), so it is left as-is. If the extra
           traffic ever matters, throttle it between the bridge and
           robot_state_publisher rather than here. -->
      <joint_name>left_up_wheel_link_joint</joint_name>
      <joint_name>right_up_wheel_link_joint</joint_name>
      <joint_name>left_middle_wheel_link_joint</joint_name>
      <joint_name>right_middle_wheel_link_joint</joint_name>
      <joint_name>left_down_wheel_link_joint</joint_name>
      <joint_name>right_down_wheel_link_joint</joint_name>
    </plugin>

    <!-- Second publisher exposing ONLY the physically instrumented wheels.
         /joint_states carries all six because robot_state_publisher needs a state
         for every revolute joint to emit its TF - drop a joint from it and that
         wheel's frame disappears from TF entirely, it does not merely freeze.
         /wheel_encoders is the honest proprioceptive stream: what the hardware can
         actually measure. Consume this one in perception/estimation code so the
         algorithms do not silently depend on state the real robot lacks. -->
    <plugin filename='gz-sim-joint-state-publisher-system'
            name='gz::sim::systems::JointStatePublisher'>
      <topic>wheel_encoders</topic>
      <joint_name>left_up_wheel_link_joint</joint_name>
      <joint_name>right_up_wheel_link_joint</joint_name>
    </plugin>


  </model>
</sdf>
