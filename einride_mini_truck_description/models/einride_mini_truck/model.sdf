        <inertia>
          <ixx>0.000116541923504163</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000170742352371108</iyy><iyz>0</iyz>
          <izz>0.000116541923504163</izz>
        </inertia>
      </inertial>
      <visual name='right_down_wheel_link_visual'>
        <geometry>
          <mesh><scale>1 1 1</scale>
            <uri>package://einride_mini_truck_description/models/einride_mini_truck/meshes/right_down_wheel_link.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.06 0.06 0.06 1</diffuse>
          <specular>0.04 0.04 0.04 1</specular>
        </material>
      </visual>
