        <geometry>
          <cylinder><radius>0.04</radius><length>0.0425</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <!-- Longitudinal grip high, lateral lower: a 6-wheel skid-steer has to
                   scrub sideways to turn. The original model specified no friction at all. -->
              <mu>1.0</mu>
              <mu2>0.6</mu2>
              <fdir1>1 0 0</fdir1>
