<?xml version='1.0'?>
<!--
  einride-mini-truck: 6-wheel skid-steer rover.

  Ported from ugv_ws/ugv_description (Gazebo Classic / gazebo_ros plugins) to
  ROS 2 Jazzy + Gazebo Harmonic (gz-sim 8) systems. Fixes applied relative to
  the original are called out inline; see the description package README.
-->
<sdf version='1.10'>
  <model name='einride_mini_truck'>
    <self_collide>false</self_collide>
    <static>false</static>

    <!-- Ground-projected root frame. Carries a token inertia because gz-sim
         requires every link to have one; it is welded to base_link. -->
    <link name='base_footprint'>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz></inertia>
      </inertial>
    </link>

    <!-- Chassis. Mass and inertia are the original values with the two embedded
         middle wheels subtracted, since those are now real links. -->
    <link name='base_link'>
      <pose relative_to='base_footprint'>0.00046 0 0.08 0 0 0</pose>
      <inertial>
        <mass>2.369578776108720</mass>
        <inertia>
          <ixx>0.002425710</ixx><ixy>0</ixy><ixz>3.77886436056975E-05</ixz>
          <iyy>0.008295139</iyy><iyz>0</iyz>
          <izz>0.008771993</izz>
        </inertia>
      </inertial>
      <visual name='base_link_visual'>
        <geometry>
          <mesh><scale>1 1 1</scale><uri>package://einride_mini_truck_description/models/einride_mini_truck/meshes/base_link.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.09 0.10 0.12 1</ambient>
          <diffuse>0.17 0.19 0.22 1</diffuse>
          <specular>0.25 0.25 0.27 1</specular>
        </material>
      </visual>
      <collision name='base_link_collision'>
        <geometry>
          <mesh><scale>1 1 1</scale><uri>package://einride_mini_truck_description/models/einride_mini_truck/meshes/base_link.stl</uri></mesh>
        </geometry>
      </collision>
    </link>
    <joint name='base_joint' type='fixed'>
      <parent>base_footprint</parent>
      <child>base_link</child>
    </joint>

    <!-- IMU. The original parented this to base_footprint at 0 0 0, i.e. on the
         ground plane ~80 mm below the real board; it now sits on the chassis. -->
    <link name='base_imu_link'>
      <pose relative_to='base_link'>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-6</iyy><iyz>0</iyz>
          <izz>1e-6</izz>
        </inertia>
      </inertial>
      <!-- TDK InvenSense ICM-20948: 9-axis, gyro + accel + an AK09916 magnetometer
           on the same die. Modelled as two gz sensors because gz has no combined
           9-axis type: the imu below and the magnetometer after it.

           Noise is DERIVED from datasheet noise densities at 100 Hz bandwidth,
           not from quoted sigmas: gyro 0.015 deg/s/sqrt(Hz) -> 2.62e-3 rad/s,
           accel 230 ug/sqrt(Hz) -> 2.26e-2 m/s^2. The source ugv_description
           declared 2e-4 rad/s for the gyro, roughly 13x better than this part
           actually achieves. Note this makes the chassis gyro about 2x NOISIER
           than the BMI270 inside the OAK-D Lite. -->
      <sensor name='icm20948' type='imu'>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <topic>imu</topic>
        <gz_frame_id>base_imu_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x><noise type='gaussian'><mean>0.0</mean><stddev>2.62e-3</stddev></noise></x>
            <y><noise type='gaussian'><mean>0.0</mean><stddev>2.62e-3</stddev></noise></y>
            <z><noise type='gaussian'><mean>0.0</mean><stddev>2.62e-3</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type='gaussian'><mean>0.0</mean><stddev>2.26e-2</stddev></noise></x>
            <y><noise type='gaussian'><mean>0.0</mean><stddev>2.26e-2</stddev></noise></y>
            <z><noise type='gaussian'><mean>0.0</mean><stddev>2.26e-2</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- AK09916 magnetometer, the third axis-set of the ICM-20948. Its max ODR is
           100 Hz, which is what is set here. Sigma of 3e-7 T (0.3 uT) is an estimate
           around the part's 0.15 uT/LSB resolution, not a datasheet figure. -->
      <sensor name='ak09916' type='magnetometer'>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <topic>mag</topic>
        <gz_frame_id>base_imu_link</gz_frame_id>
        <magnetometer>
          <x><noise type='gaussian'><mean>0.0</mean><stddev>3e-7</stddev></noise></x>
          <y><noise type='gaussian'><mean>0.0</mean><stddev>3e-7</stddev></noise></y>
          <z><noise type='gaussian'><mean>0.0</mean><stddev>3e-7</stddev></noise></z>
        </magnetometer>
      </sensor>
    </link>
    <joint name='imu_joint' type='fixed'>
      <parent>base_link</parent>
      <child>base_imu_link</child>
    </joint>

    <!-- front left -->
    <link name='left_up_wheel_link'>
      <pose relative_to='base_footprint'>0.08596 0.08726 0.04 0 0 0</pose>
      <inertial>
        <mass>0.207085933743005</mass>
        <inertia>
          <ixx>0.000116541923504163</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000170742352371108</iyy><iyz>0</iyz>
          <izz>0.000116541923504163</izz>
        </inertia>
      </inertial>
      <visual name='left_up_wheel_link_visual'>
        <geometry>
          <mesh><scale>1 1 1</scale>
            <uri>package://einride_mini_truck_description/models/einride_mini_truck/meshes/left_up_wheel_link.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.06 0.06 0.06 1</diffuse>
          <specular>0.04 0.04 0.04 1</specular>
        </material>
      </visual>
      <!-- Cylinder primitive instead of the mesh: mesh-mesh wheel contacts are the
           main source of jitter and cost in the original model. -->
      <collision name='left_up_wheel_link_collision'>
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder><radius>0.04</radius><length>0.0425</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <!-- Longitudinal grip high, lateral lower: a 6-wheel skid-steer has to
                   scrub sideways to turn. The original model specified no friction at all. -->
              <mu>1.0</mu>
              <mu2>0.6</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
          <contact><ode><kp>1e6</kp><kd>100</kd></ode></contact>
        </surface>
      </collision>
    </link>
    <joint name='left_up_wheel_link_joint' type='revolute'>
      <parent>base_link</parent>
      <child>left_up_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>10</effort><velocity>30</velocity></limit>
        <dynamics><damping>0.001</damping><friction>0.002</friction></dynamics>
      </axis>
    </joint>

    <!-- front right -->
    <link name='right_up_wheel_link'>
      <pose relative_to='base_footprint'>0.08596 -0.08726 0.04 0 0 0</pose>
      <inertial>
        <mass>0.207085933743005</mass>
        <inertia>
          <ixx>0.000116541923504163</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000170742352371108</iyy><iyz>0</iyz>
          <izz>0.000116541923504163</izz>
        </inertia>
      </inertial>
      <visual name='right_up_wheel_link_visual'>
        <geometry>
          <mesh><scale>1 1 1</scale>
            <uri>package://einride_mini_truck_description/models/einride_mini_truck/meshes/right_up_wheel_link.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.06 0.06 0.06 1</diffuse>
          <specular>0.04 0.04 0.04 1</specular>
        </material>
      </visual>
      <!-- Cylinder primitive instead of the mesh: mesh-mesh wheel contacts are the
           main source of jitter and cost in the original model. -->
      <collision name='right_up_wheel_link_collision'>
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder><radius>0.04</radius><length>0.0425</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <!-- Longitudinal grip high, lateral lower: a 6-wheel skid-steer has to
                   scrub sideways to turn. The original model specified no friction at all. -->
              <mu>1.0</mu>
              <mu2>0.6</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
          <contact><ode><kp>1e6</kp><kd>100</kd></ode></contact>
        </surface>
      </collision>
    </link>
    <joint name='right_up_wheel_link_joint' type='revolute'>
      <parent>base_link</parent>
      <child>right_up_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>10</effort><velocity>30</velocity></limit>
        <dynamics><damping>0.001</damping><friction>0.002</friction></dynamics>
      </axis>
    </joint>

    <!-- middle left  (was fused into base_link.stl) -->
    <link name='left_middle_wheel_link'>
      <pose relative_to='base_footprint'>0.00000 0.08726 0.04 0 0 0</pose>
      <inertial>
        <mass>0.207085933743005</mass>
        <inertia>
          <ixx>0.000116541923504163</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000170742352371108</iyy><iyz>0</iyz>
          <izz>0.000116541923504163</izz>
        </inertia>
      </inertial>
      <visual name='left_middle_wheel_link_visual'>
        <geometry>
          <mesh><scale>1 1 1</scale>
            <uri>package://einride_mini_truck_description/models/einride_mini_truck/meshes/left_middle_wheel_link.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.06 0.06 0.06 1</diffuse>
          <specular>0.04 0.04 0.04 1</specular>
        </material>
      </visual>
      <!-- Cylinder primitive instead of the mesh: mesh-mesh wheel contacts are the
           main source of jitter and cost in the original model. -->
      <collision name='left_middle_wheel_link_collision'>
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder><radius>0.04</radius><length>0.0425</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <!-- Longitudinal grip high, lateral lower: a 6-wheel skid-steer has to
                   scrub sideways to turn. The original model specified no friction at all. -->
              <mu>1.0</mu>
              <mu2>0.6</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
          <contact><ode><kp>1e6</kp><kd>100</kd></ode></contact>
        </surface>
      </collision>
    </link>
    <joint name='left_middle_wheel_link_joint' type='revolute'>
      <parent>base_link</parent>
      <child>left_middle_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>10</effort><velocity>30</velocity></limit>
        <dynamics><damping>0.001</damping><friction>0.002</friction></dynamics>
      </axis>
    </joint>

    <!-- middle right (was fused into base_link.stl) -->
    <link name='right_middle_wheel_link'>
      <pose relative_to='base_footprint'>0.00000 -0.08726 0.04 0 0 0</pose>
      <inertial>
        <mass>0.207085933743005</mass>
        <inertia>
          <ixx>0.000116541923504163</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000170742352371108</iyy><iyz>0</iyz>
          <izz>0.000116541923504163</izz>
        </inertia>
      </inertial>
      <visual name='right_middle_wheel_link_visual'>
        <geometry>
          <mesh><scale>1 1 1</scale>
            <uri>package://einride_mini_truck_description/models/einride_mini_truck/meshes/right_middle_wheel_link.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.06 0.06 0.06 1</diffuse>
          <specular>0.04 0.04 0.04 1</specular>
        </material>
      </visual>
      <!-- Cylinder primitive instead of the mesh: mesh-mesh wheel contacts are the
           main source of jitter and cost in the original model. -->
      <collision name='right_middle_wheel_link_collision'>
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry>
          <cylinder><radius>0.04</radius><length>0.0425</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <!-- Longitudinal grip high, lateral lower: a 6-wheel skid-steer has to
