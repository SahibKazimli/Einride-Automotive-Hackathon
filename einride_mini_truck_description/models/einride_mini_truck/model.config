<?xml version="1.0"?>
<model>
  <name>einride_mini_truck</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>

  <author>
    <name>Vladyslav Aleksashyn</name>
    <email>vladyslav.aleksashyn@einride.tech</email>
  </author>

  <description>
    Six-wheel skid-steer rover for ROS 2 Jazzy + Gazebo Harmonic. Ported from the
    Gazebo Classic ugv_description model (author: DUDU), with the two middle wheels
    separated from the chassis mesh and driven, corrected wheel radius, and gz-sim
    sensor/system plugins. The source model's pan-tilt head is not included.
  </description>
</model>
