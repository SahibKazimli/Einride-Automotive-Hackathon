<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>einride_mini_truck_description</name>
  <version>0.0.0</version>
  <description>SDFormat description files for the einride_mini_truck project</description>
  <maintainer email="vladyslav.aleksashyn@einride.tech">Vladyslav Aleksashyn</maintainer>
  <license>Apache 2.0</license>
  <author>Michael Carroll</author>
  <author>Dharini Dutia</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- tools/sdf_to_urdf.cpp, which turns model.sdf into the model.urdf
       robot_description carries. sdformat_urdf is the same converter
       robot_state_publisher used to run on the SDF in-process, so the
       frames it produces are the ones the stack already uses. -->
  <build_depend>sdformat_urdf</build_depend>
  <build_depend>sdformat_vendor</build_depend>
  <build_depend>tinyxml2_vendor</build_depend>
  <build_depend>urdfdom</build_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
