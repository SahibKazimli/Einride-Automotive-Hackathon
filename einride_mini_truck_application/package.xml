<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>einride_mini_truck_application</name>
  <version>0.0.0</version>
  <description>Competition application: Saga AI client and mission on top of Nav2, opennav_docking, apriltag_ros and robot_localization</description>
  <maintainer email="sahib.kazimli130@gmail.com">Sahib Kazimli</maintainer>
  <license>Apache 2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>action_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>apriltag_msgs</depend>
  <depend>tf_transformations</depend>
  <depend>python3-requests</depend>

  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- Started by our launch files (sudo apt install ros-jazzy-...) -->
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>image_proc</exec_depend>
  <exec_depend>apriltag_ros</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <exec_depend>opennav_docking</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>laser_filters</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
