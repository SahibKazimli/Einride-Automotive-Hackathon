# Configuration for the einride-mini-truck systemd service.
# Installed to /etc/default/@SERVICE_NAME@.
#
# THIS FILE IS NOT OVERWRITTEN BY A REDEPLOY. It is the robot's local
# configuration, so provision.sh and deploy.sh both leave an existing copy alone
# and write the new template beside it as .new when the two differ.
#
# Read by systemd, not by a shell: KEY=value only. No $substitution, no command
# substitution, and quote any value containing spaces.
#
# After editing:  sudo systemctl restart @SERVICE_NAME@

# --- workspace -------------------------------------------------------------
# Where provision.sh installed the cross-built workspace. The wrapper
# sources $WORKSPACE/install/setup.bash and fails loudly if it is absent.
#
# Changing this to a tree built for a different prefix will not work: colcon
# bakes absolute paths into the environment hooks, so a tree has to be installed
# at the path it was built for. Pass --prefix to both the build and the deploy
# instead - both deploy scripts do that for you, and refuse a mismatch.
WORKSPACE=@WORKSPACE@

# ROS itself is not shipped by the deploy; this is the robot's own install.
ROS_DISTRO_SETUP=/opt/ros/jazzy/setup.bash

# --- ROS middleware --------------------------------------------------------
# Must match whatever you run `ros2 topic echo` with, or the robot is invisible.
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Shared memory off; user data goes over UDP.
#
# Fast DDS prefers shared memory between processes on one host, and on this
# hardware it does not work: segments are never created, and the failure is
# entirely silent. Discovery runs over UDP multicast regardless, so every topic
# still appears in `ros2 topic list` and in Foxglove, with full QoS - while not
# one message crosses a process boundary. A robot that looks perfectly healthy
# and publishes nothing, which is the worst shape a fault can take.
#
# Measured on the Jetson: with the default transport, /tf_static (latched, so it
# must arrive) and the lidar both deliver zero. With UDPv4, 1 and 71.
#
# The cost is CPU on large messages - camera images get fragmented over
# loopback rather than shared. If that ever matters more than the reliability,
# the honest options are LARGE_DATA (TCP for user data) or fixing shared memory
# on the platform; going back to the default just restores the silent failure.
FASTDDS_BUILTIN_TRANSPORTS=UDPv4

# --- launch arguments ------------------------------------------------------
# These map one-for-one onto hardware.launch.py's arguments.
#
# rviz is false and stays false: the Jetson runs headless, and RViz under a
# service has no display to open on. Debug with RViz on your own machine
# against the same ROS_DOMAIN_ID.
RVIZ=false
LIDAR=true
CAMERA=true

# Parameter file overrides. Left unset, the launch file's own defaults apply -
# einride_mini_truck_hardware/config/hardware.yaml and
# einride_mini_truck_bringup/config/ldlidar.yaml from the installed workspace.
# Set these only to point at a file outside the workspace, e.g. per-robot
# calibration that should survive a rebuild.
#HARDWARE_PARAMS=/etc/einride-mini-truck/hardware.yaml
#LIDAR_PARAMS=/etc/einride-mini-truck/ldlidar.yaml

# Anything else to append to the ros2 launch command line, space separated,
# e.g. EXTRA_LAUNCH_ARGS="log_level:=debug". Split on whitespace, so no
# individual argument may contain a space.
EXTRA_LAUNCH_ARGS=

# --- foxglove bridge -------------------------------------------------------
# Read by the @SERVICE_NAME@-foxglove service, which runs foxglove_bridge: a
# WebSocket server the Foxglove app connects to at ws://<robot>:8765.
#
# They share this file rather than having one each because the two units have to
# agree about ROS_DOMAIN_ID and RMW_IMPLEMENTATION above - a bridge on a
# different domain sees an empty graph and looks broken - and a second copy of
# those settings is a second chance to get them different.
#
# Nothing here reaches out to Foxglove's servers. The robot only listens; the
# app connects inward, so no account and no outbound access is involved.

FOXGLOVE_PORT=8765

# 0.0.0.0 because the point is to reach it from a laptop. The bridge has no
# authentication of its own, so what keeps it private is the network the robot
# is on. Set this to 127.0.0.1 and use an ssh tunnel if that is not enough:
#     ssh -L 8765:localhost:8765 <user>@<robot>
FOXGLOVE_ADDRESS=0.0.0.0

# Anything else to append, space separated - the launch file's arguments, e.g.
#   FOXGLOVE_EXTRA_ARGS="topic_whitelist:=['/scan','/tf'] send_buffer_limit:=10000000"
# Worth reaching for on a slow link: the camera topics dominate the bandwidth,
# and a whitelist is the difference between a usable connection and a stalled
# one.
FOXGLOVE_EXTRA_ARGS=
