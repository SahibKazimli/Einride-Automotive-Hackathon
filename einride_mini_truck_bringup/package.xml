<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>einride_mini_truck_bringup</name>
  <version>0.0.0</version>
  <description>Contains launch files for the einride_mini_truck project</description>
  <maintainer email="vladyslav.aleksashyn@einride.tech">Vladyslav Aleksashyn</maintainer>
  <license>Apache 2.0</license>
  <author>Michael Carroll</author>
  <author>Dharini Dutia</author>

  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <!-- robot_state_publisher parses the model SDF through sdformat_urdf -->
  <depend>robot_state_publisher</depend>
  <depend>sdformat_urdf</depend>
  <exec_depend>rviz2</exec_depend>
  <!-- throttles the physics-rate /joint_states_raw down to /joint_states -->
  <exec_depend>topic_tools</exec_depend>
  <depend>einride_mini_truck_description</depend>
  <depend>einride_mini_truck_gazebo</depend>

  <!-- hardware.launch.py only. The three device drivers are not needed to run
       the simulation, and are not available off the robot, so they are
       exec-only and every one of them can be switched off with a launch
       argument. -->
  <exec_depend>einride_mini_truck_hardware</exec_depend>
  <!-- ldlidar is not a released ROS package: build it from source, e.g. the
       copy in ugv_ws/src/ugv_else/ldlidar. rosdep will warn that it cannot
       resolve this key, which the README's -r flag turns into a warning
       rather than a failure. -->
  <exec_depend>ldlidar</exec_depend>
  <exec_depend>depthai_ros_driver</exec_depend>
  <!-- derives /scan/points from /scan, which the LD19 driver does not publish -->
  <exec_depend>pointcloud_to_laserscan</exec_depend>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_cmake_flake8</test_depend>
  <test_depend>ament_cmake_pep257</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>rclpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

