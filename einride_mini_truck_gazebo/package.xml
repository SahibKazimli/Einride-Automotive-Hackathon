<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>einride_mini_truck_gazebo</name>
  <version>0.0.0</version>
  <description>Gazebo-specific implementations for the einride_mini_truck project</description>
  <maintainer email="vladyslav.aleksashyn@einride.tech">Vladyslav Aleksashyn</maintainer>
  <license>Apache 2.0</license>
  <!-- The vendored Fuel prop meshes and textures under props/ are third-party and
       public domain. CC0 requires no attribution; declared so the package's
       licensing is self-describing. Provenance is in props/MANIFEST.sha256 and
       each prop's upstream.model.config.txt. -->
  <license file="props/LICENSE.CC0">CC0-1.0</license>
  <author>Michael Carroll</author>
  <author>Dharini Dutia</author>

  <depend>einride_mini_truck_description</depend>

  <!-- Gazebo as vendored by the ROS 2 distro, so no standalone Gazebo install is needed. -->
  <depend>gz_cmake_vendor</depend>
  <depend>gz_plugin_vendor</depend>
  <depend>gz_common_vendor</depend>
  <depend>gz_sim_vendor</depend>

  <!-- ld19_scan_model, the simulation-side stand-in for the LD19 driver. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <test_depend>ament_cmake_flake8</test_depend>
  <test_depend>ament_cmake_pep257</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

