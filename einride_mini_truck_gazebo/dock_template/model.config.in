<?xml version="1.0"?>
<model>
  <name>@DOCK_MODEL@</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>

  <author>
    <name>Vladyslav Aleksashyn</name>
    <email>vladyslav.aleksashyn@einride.tech</email>
  </author>

  <description>
    Warehouse delivery dock @DOCK_LETTER@, tag36h11 id @DOCK_TAG_ID@.
    GENERATED from dock_template/model.config.in - do not edit.
    Dock: a shallow trapezoidal bay, three panels - middle, left, right - all
    350 mm tall. A 400 mm back wall carries a 100 mm tag36h11 AprilTag at
    z=130 mm; the two 240 mm wings flare at 45 deg so a 2D LiDAR sees three
    segments and can fix x, y and yaw. A dark accent band wraps the inner
    faces at z 200-260, and the back wall carries a letter decal (matching
    the tag id) at z 269-341 - both clear of the frozen 80-180 mm scan band
    and of the tag. The dock_approach_pose frame gives the docked pose of the
    rover's base_footprint.
  </description>
</model>
